---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { DISCIPLINES, url, type Discipline } from '../lib/site';
import { archive } from '../data/archive';

const projects = await getCollection('projects');

interface Row {
  title: string;
  year: string;
  kind: string;
  disciplines: Discipline[];
  note: string;
  href: string;
  external: boolean;
}

// Within a year: case studies, then projects, then everything else.
const rank = (kind: string) => (kind === 'Case study' ? 0 : kind === 'Project' ? 1 : 2);

const rows: Row[] = [
  ...projects.map((p) => ({
    title: p.data.title,
    year: p.data.year,
    kind: p.data.tier === 'flagship' ? 'Case study' : 'Project',
    disciplines: p.data.disciplines,
    note: p.data.tagline,
    href: url(`work/${p.id}`),
    external: false,
  })),
  ...archive.map((a) => ({ ...a, href: a.href ?? '', external: true })),
].sort(
  (a, b) => Number(b.year) - Number(a.year) || rank(a.kind) - rank(b.kind) || a.title.localeCompare(b.title),
);
---

<Base
  title="Archive"
  description="Everything Anders Tan has made: case studies, projects, coursework, experiments and unfinished games."
  flags={['at-archive']}
>
  <header class="top wrap">
    <p class="label">{rows.length} entries · newest first</p>
    <h1>Everything</h1>
    <p class="intro">
      Case studies, smaller projects, coursework, experiments and things I never finished. The discipline masks in the
      header filter this list too.
    </p>
  </header>

  <div class="wrap" data-filter-group>
    <ul class="list">
      {
        rows.map((row) => (
          <li data-disc={row.disciplines.join(' ')}>
            <a href={row.href} rel={row.external ? 'noopener' : undefined}>
              <span class="label yr">{row.year}</span>
              <span class="main">
                <strong>
                  {row.title}
                  {row.external && <span aria-hidden="true"> ↗</span>}
                </strong>
                <span>{row.note}</span>
              </span>
              <span class="label kind">{row.kind}</span>
              <span class="dots">
                {row.disciplines.map((d) => (
                  <span class="dot" data-d={d} title={DISCIPLINES[d].label} />
                ))}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="empty" data-filter-empty hidden>Every mask is off, so the archive is empty. Press 1, 2 or 3.</p>
  </div>
</Base>

<style>
  .top {
    padding-top: clamp(1.5rem, 5vw, 4rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    margin-top: 0.5rem;
    font-size: clamp(3.4rem, 15vw, 13rem);
    font-variation-settings: 'wdth' 75;
    letter-spacing: -0.02em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .intro {
    margin: 1.2rem 0 0;
    font-size: 1.15rem;
    max-width: 52ch;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }

  .list a {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) 8rem auto;
    gap: 0.3rem 1.25rem;
    align-items: baseline;
    padding: 0.85rem 0;
    text-decoration: none;
    transition:
      padding 0.2s,
      background 0.2s;
  }

  .list a:hover {
    padding-inline: 0.75rem;
    background: var(--ink);
    color: var(--paper);
  }

  .list a:hover .label {
    color: inherit;
  }

  .main strong {
    display: block;
    font-size: 1.15rem;
    font-variation-settings: 'wdth' 86;
    line-height: 1.2;
  }

  .main > span {
    display: block;
    font-size: 0.92rem;
    line-height: 1.4;
    opacity: 0.8;
    max-width: 70ch;
  }

  .empty {
    padding: 2rem 0;
    font-family: var(--font-pixel);
    font-size: 1.1rem;
    max-width: none;
  }

  @media (max-width: 760px) {
    .list a {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
    }
    .kind {
      display: none;
    }
  }
</style>
