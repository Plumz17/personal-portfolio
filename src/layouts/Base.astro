---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Guide from '../components/Guide.astro';
import Terminal from '../components/Terminal.astro';
import { url } from '../lib/site';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Page flags the guide reacts to, for example ["at-project", "at-31-days"]. */
  flags?: string[];
  image?: string;
}

const {
  title,
  description = `${profile.shortName}: game programmer and software engineer. Games, software and machine learning projects, with the code and the numbers behind them.`,
  flags = [],
  image,
} = Astro.props;

const pageTitle = title ? `${title} · ${profile.shortName}` : `${profile.shortName} · ${profile.role}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-base={base} data-flags={flags.join(' ')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="theme-color" content="#f1eee6" />
    <script is:inline>
      // Set the theme before first paint so there is no flash.
      (function () {
        // ?theme=day or ?theme=dusk wins, so a link can be shared in either mode.
        var theme = (location.search.match(/[?&]theme=(day|dusk)/) || [])[1];
        try {
          theme = theme || JSON.parse(localStorage.getItem('pf.state.v1') || '{}').theme;
        } catch (e) {}
        if (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dusk';
        if (theme === 'dusk') document.documentElement.dataset.theme = 'dusk';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Guide />
    <Terminal />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 0.5rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
  }
  .skip:focus {
    top: 0.5rem;
  }
  main {
    min-height: 60vh;
  }
</style>
