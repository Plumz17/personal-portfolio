---
import { DISCIPLINES, DISCIPLINE_KEYS, url } from '../lib/site';
import { profile } from '../data/profile';

interface Props {
  /** Show the discipline masks: only on pages with something to filter. */
  filters?: boolean;
}

const { filters = false } = Astro.props;
---

<header class="site-header">
  <div class="bar wrap">
    <a class="brand" href={url('/')} aria-label={`${profile.shortName}, home`}>
      <span class="brand-mark" aria-hidden="true"><i data-d="games"></i><i data-d="software"></i><i data-d="ai"></i></span>
      <span class="brand-name">{profile.shortName}</span>
    </a>

    {
      filters && (
        <div class="masks" role="group" aria-label="Show or hide a discipline">
          {DISCIPLINE_KEYS.map((d) => (
            <button
              type="button"
              class="mask"
              data-mask={d}
              data-d={d}
              aria-pressed="true"
              title={`${DISCIPLINES[d].label}: press ${DISCIPLINES[d].key} to toggle`}
            >
              <span class="mask-dot" aria-hidden="true" />
              <span class="mask-label">{DISCIPLINES[d].label}</span>
              <kbd class="key" aria-hidden="true">{DISCIPLINES[d].key}</kbd>
            </button>
          ))}
        </div>
      )
    }

    <nav class="nav" aria-label="Main">
      <a href={url('/archive')}>Archive</a>
      <a href={url('/#about')}>About</a>
    </nav>

    <button type="button" class="search" data-open-terminal aria-label="Search projects">
      <svg class="search-icon" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="6.8" cy="6.8" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M10.3 10.3L14 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
      </svg>
      <span class="search-word">Search</span>
      <kbd class="key" aria-hidden="true">/</kbd>
    </button>

    <div class="pair">
      <button type="button" class="tool" data-sound-toggle aria-pressed="false" aria-label="Sound">
        <svg class="sound-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2 6h3l4-3v10L5 10H2z" fill="currentColor" />
          <path class="waves" d="M11 5.5c1 .8 1 4.2 0 5M12.8 3.8c2 1.8 2 6.6 0 8.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          <path class="mute" d="M11 5.5l4 5M15 5.5l-4 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </button>
      <button type="button" class="tool" data-theme-toggle aria-label="Switch between day and dusk colours">
        <span class="theme-icon" aria-hidden="true"></span>
      </button>
    </div>

  </div>
</header>

<style>
  /* Solid paper, like the page under it: no frosted glass. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    margin-right: auto;
    text-decoration: none;
    font-weight: 800;
    font-variation-settings: 'wdth' 78;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Three overlapping discs, the site's mark. */
  .brand-mark {
    display: inline-flex;
    isolation: isolate;
  }
  .brand-mark i {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--d);
    mix-blend-mode: var(--blend);
  }
  .brand-mark i + i {
    margin-left: -0.3rem;
  }

  .masks {
    display: flex;
    gap: 0.25rem;
    margin-right: auto;
  }

  .nav {
    display: flex;
    gap: 0.25rem;
    margin-right: 0.6rem;
    font-size: 0.92rem;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .search,
  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0 0.7rem;
    border: 1px solid var(--ink);
    font-size: 0.88rem;
    cursor: pointer;
  }

  .search {
    background: var(--ink);
    color: var(--paper);
  }

  .search-icon {
    display: none;
    width: 1rem;
    height: 1rem;
  }

  /* Sound and colours share one frame: two settings, one place. */
  .pair {
    display: flex;
  }

  .tool {
    padding: 0;
    background: transparent;
    color: var(--ink);
  }

  .tool + .tool {
    border-left: 0;
  }

  .tool:hover,
  .search:hover {
    outline: 1px solid var(--ink);
    outline-offset: -3px;
  }

  .search:hover {
    outline-color: var(--paper);
  }

  .sound-icon {
    width: 1rem;
    height: 1rem;
  }
  [data-sound-toggle][aria-pressed='true'] .mute,
  [data-sound-toggle][aria-pressed='false'] .waves {
    display: none;
  }

  /* Half-filled disc: day on one side, dusk on the other. */
  .theme-icon {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform 0.3s;
  }

  :global([data-theme='dusk']) .theme-icon {
    transform: rotate(180deg);
  }

  /* Below 1080px the masks move into the page, next to what they filter. */
  @media (max-width: 1079px) {
    .masks {
      display: none;
    }
  }

  /* Phones: one row. Brand, search, settings. The nav links are in the
     footer and on the pages themselves. */
  @media (max-width: 699px) {
    .nav,
    .search-word,
    .search .key {
      display: none;
    }
    .search {
      padding: 0;
    }
    .search-icon {
      display: block;
    }
    .brand {
      font-size: 1.05rem;
      gap: 0.45rem;
    }
  }

  @media (max-width: 359px) {
    .brand-name {
      display: none;
    }
  }
</style>

<script>
  import { activeMasks, flags, isOn, toggleMask, toggleTheme } from '../lib/state';
  import { soundOn, toggleSound } from '../lib/sound';
  import type { Discipline } from '../lib/site';

  /** Hide every [data-disc] element whose disciplines are all switched off. */
  function applyMasks(): void {
    const active = activeMasks();
    document.querySelectorAll<HTMLElement>('[data-disc]').forEach((el) => {
      const own = (el.dataset.disc ?? '').split(' ').filter(Boolean) as Discipline[];
      el.toggleAttribute('data-masked', own.length > 0 && !own.some((d) => active.includes(d)));
    });
    // Header and in-page mask buttons share one state.
    document.querySelectorAll<HTMLButtonElement>('[data-mask]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isOn(btn.dataset.mask as Discipline)));
    });
    // Lists can show a note when the filter leaves them empty.
    document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
      const any = group.querySelector('[data-disc]:not([data-masked])') !== null;
      group.querySelector<HTMLElement>('[data-filter-empty]')?.toggleAttribute('hidden', any);
    });
    document.documentElement.dataset.masks = active.join(' ');
    flags.setTransient('masks-off', active.length === 0);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-mask]').forEach((btn) => {
    btn.addEventListener('click', () => toggleMask(btn.dataset.mask as Discipline));
  });
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', toggleTheme);

  const soundBtn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  const showSound = () => soundBtn?.setAttribute('aria-pressed', String(soundOn()));
  soundBtn?.addEventListener('click', toggleSound);
  document.addEventListener('pf:sound', showSound);
  showSound();
  document.addEventListener('pf:masks', applyMasks);
  applyMasks();

  // Keys 1, 2, 3 toggle the masks on every page, unless the visitor is typing.
  const KEYS: Record<string, Discipline> = { '1': 'games', '2': 'software', '3': 'ai' };
  document.addEventListener('keydown', (event) => {
    if (event.ctrlKey || event.metaKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target?.closest('input, textarea, select, [contenteditable], dialog[open], [data-keys]')) return;
    const d = KEYS[event.key];
    if (d) toggleMask(d);
  });
</script>
