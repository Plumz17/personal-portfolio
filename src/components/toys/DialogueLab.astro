---
// Truths Astray: edit a dialogue table, watch it play. Runs the same parser
// and runtime as the site guide (src/lib/dialogue).
import { media } from '../../lib/site';

const sample = `---
date: 2083-02-01
repeatable: "true"
triggers:
flags:
---

# Start

| Portrait | Dialogue | Tags |
| --- | --- | --- |
| ![[sarah_happy.png]] | So this is the editor. Every row is one line of dialogue. | #right |
| ![[astara_thinking.png]] | *And the picture decides who is speaking?* | #left #thought |
| ![[sarah_neutral.png]] | The filename does. **sarah_happy** is my name and my mood. | #right |
| ![[astara_neutral.png]] | Show me a branch. → #Branch <br>What are flags? → #Flags | #left #choice |

# Branch

| Portrait | Dialogue | Tags |
| --- | --- | --- |
| ![[sarah_happy.png]] | You just took one. This heading is where the arrow pointed. → #Again | #right |

# Flags

| Portrait | Dialogue | Tags |
| --- | --- | --- |
| ![[sarah_neutral.png]] | A choice can remember things. Go back to the top once and a new option appears. → #Again | #right |

# Again

| Portrait | Dialogue | Tags |
| --- | --- | --- |
| ![[astara_neutral.png]] | Back to the top. → #Start {seen-once} <br>I have been here before. → #Secret [seen-once] <br>That's enough. → #End | #left #choice |

# Secret

| Portrait | Dialogue | Tags |
| --- | --- | --- |
| ![[sarah_confused.png]] | That option only exists because a flag was set. Delete **[seen-once]** from the table and it is always there. | #right |

# End

| Portrait | Dialogue | Tags |
| --- | --- | --- |
| ![[astara_happy.png]] | Change anything on the left. We'll say it. | #left |
`;

const portraits = [
  'astara_neutral',
  'astara_happy',
  'astara_thinking',
  'astara_confused',
  'sarah_neutral',
  'sarah_happy',
  'sarah_confused',
  'dorothy_neutral',
  'dorothy_happy',
  'dorothy_confused',
  'dorothy_unhappy',
  'dorothy_sad',
];
---

<div class="toy lab" data-lab data-portraits={portraits.join(' ')} data-portrait-base={media('truths-astray/portraits/')}>
  <div class="toy-head">
    <strong>Dialogue lab</strong>
    <span class="label" data-lab-status>Parsed</span>
  </div>
  <div class="lab-grid">
    <label class="lab-source">
      <span class="label">Vault file · Markdown</span>
      <textarea data-lab-source spellcheck="false" autocapitalize="off" rows="18">{sample}</textarea>
    </label>
    <div class="lab-out">
      <div class="lab-stage" data-keys>
        <div data-lab-view></div>
        <p class="lab-done" data-lab-done hidden>End of dialogue.</p>
      </div>
      <div class="lab-actions">
        <button type="button" class="btn" data-lab-restart>Restart</button>
        <span class="label" data-lab-flags>Flags: none</span>
      </div>
      <details>
        <summary class="label">What the game loads: parsed JSON</summary>
        <pre data-lab-json></pre>
      </details>
    </div>
  </div>
  <div class="toy-note">
    <p>
      Syntax: <code>text → #Section {'{'}flags{'}'} [requires]</code>. Options in a <code>#choice</code> row are separated by{' '}
      <code>&lt;br&gt;</code>. Typing <code>-&gt;</code> works in place of the arrow. Available portraits:{' '}
      {portraits.join(', ')}.
    </p>
  </div>
</div>

<style>
  .lab-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  .lab-source {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.4rem;
    padding: 0.8rem 0.9rem;
    border-right: 1px solid var(--rule);
  }

  textarea {
    width: 100%;
    min-height: 22rem;
    padding: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    background: var(--paper-2);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.55;
    white-space: pre;
    overflow: auto;
    resize: vertical;
    tab-size: 2;
  }

  .lab-out {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: 0.8rem 0.9rem;
    min-width: 0;
  }

  .lab-stage {
    display: grid;
    align-content: center;
    min-height: 13rem;
    padding: 1rem 0.9rem 1.2rem 0.6rem;
    background:
      linear-gradient(rgb(15 20 30 / 0.55), rgb(15 20 30 / 0.55)),
      repeating-linear-gradient(90deg, #26303f 0 2px, #1c2532 2px 26px);
  }

  .lab-done {
    margin: 0;
    color: #cfd6e2;
    font-family: var(--font-pixel);
    text-align: center;
  }

  .lab-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  details summary {
    cursor: pointer;
    padding-block: 0.4rem;
  }

  pre {
    max-height: 16rem;
    margin: 0.4rem 0 0;
    padding: 0.7rem;
    overflow: auto;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  [data-lab-status][data-error] {
    color: var(--games-ink);
  }

  @media (max-width: 860px) {
    .lab-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .lab-source {
      border-right: 0;
      border-top: 1px solid var(--rule);
    }
    .lab-out {
      order: -1;
    }
    textarea {
      min-height: 14rem;
    }
  }
</style>

<script>
  import { parseDialogue, type Dialogue, type DialogueLine } from '../../lib/dialogue/parser';
  import { DialogueRunner, type FlagStore } from '../../lib/dialogue/runtime';
  import { DialogueView, type PortraitSource } from '../../lib/dialogue/view';
  import { reducedMotion } from '../../lib/state';

  document.querySelectorAll<HTMLElement>('[data-lab]').forEach((root) => {
    const source = root.querySelector<HTMLTextAreaElement>('[data-lab-source]')!;
    const status = root.querySelector<HTMLElement>('[data-lab-status]')!;
    const json = root.querySelector<HTMLElement>('[data-lab-json]')!;
    const done = root.querySelector<HTMLElement>('[data-lab-done]')!;
    const flagsLabel = root.querySelector<HTMLElement>('[data-lab-flags]')!;
    const viewEl = root.querySelector<HTMLElement>('[data-lab-view]')!;
    const known = new Set((root.dataset.portraits ?? '').split(' '));
    const base = root.dataset.portraitBase ?? '';

    // The lab keeps its own flags so experiments never touch the site guide's memory.
    const set = new Set<string>();
    const showFlags = () => (flagsLabel.textContent = `Flags: ${[...set].join(', ') || 'none'}`);
    const flags: FlagStore = {
      has: (f) => set.has(f),
      set: (f) => (set.add(f), showFlags()),
      clear: (f) => (set.delete(f), showFlags()),
      isCompleted: () => false,
      markCompleted: () => {},
    };

    const resolvePortrait = (line: DialogueLine): PortraitSource | null => {
      const stem = line.portrait.replace(/\.[^.]+$/, '').toLowerCase();
      return known.has(stem) ? { src: `${base}${stem}.png` } : null;
    };

    const view = new DialogueView(viewEl, {
      resolvePortrait,
      instant: reducedMotion(),
      onAdvance: () => runner.advance(),
      onChoose: (option) => runner.choose(option),
    });

    const runner = new DialogueRunner(flags, {
      onLine: (line) => view.showLine(line),
      onChoice: (line, options) => view.showChoices(line, options),
      onFinish: () => {
        view.clear();
        viewEl.hidden = true;
        done.hidden = false;
      },
    });

    let current: Dialogue | null = null;

    function play(resetFlags: boolean): void {
      if (!current) return;
      if (resetFlags) {
        set.clear();
        showFlags();
      }
      viewEl.hidden = false;
      done.hidden = true;
      // Sections are mutated by #random lines, so always run a fresh copy.
      runner.start(structuredClone(current));
    }

    function compile(): void {
      try {
        current = parseDialogue('lab', source.value);
        const lines = Object.values(current.sections).reduce((n, s) => n + s.length, 0);
        status.textContent = `Parsed · ${Object.keys(current.sections).length} sections · ${lines} lines`;
        status.removeAttribute('data-error');
        json.textContent = JSON.stringify(current, null, 2);
        play(true);
      } catch (error) {
        status.textContent = `Not valid yet: ${(error as Error).message}`;
        status.setAttribute('data-error', '');
      }
    }

    let timer = 0;
    source.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(compile, 300);
    });
    root.querySelector('[data-lab-restart]')?.addEventListener('click', () => play(true));
    compile();
  });
</script>
