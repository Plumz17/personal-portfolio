---
// Situs Tertinggal: the DiagonalContainer layout rule from
// ui/title_screen/diagonal_container.gd, applied to the game's title buttons.
import { media } from '../../lib/site';

const buttons = [
  { src: media('situs-tertinggal/new_game.png'), label: 'New game' },
  { src: media('situs-tertinggal/level_select.png'), label: 'Level select' },
  { src: media('situs-tertinggal/settings.png'), label: 'Settings' },
  { src: media('situs-tertinggal/exit.png'), label: 'Exit' },
];
---

<div class="toy menu" data-menu>
  <div class="toy-head">
    <strong>DiagonalContainer</strong>
    <span class="label">Scene values: x_dev −60, y_dev 120, rot_dev 10</span>
  </div>

  <div class="menu-grid">
    <div class="menu-stage" data-menu-stage style={`background-image:url(${media('situs-tertinggal/bg.webp')})`}>
      <div class="menu-scene" data-menu-scene>
        {
          buttons.map((b) => (
            <button type="button" class="menu-btn" data-menu-btn aria-label={b.label}>
              <img src={b.src} alt="" width="800" height="160" loading="lazy" />
            </button>
          ))
        }
      </div>
    </div>

    <div class="menu-side">
      <div class="field">
        <div class="field-row">
          <label for="dm-x">x_dev</label>
          <output data-o="x">−60</output>
        </div>
        <input id="dm-x" type="range" min="-200" max="200" step="5" value="-60" data-p="x" />
      </div>
      <div class="field">
        <div class="field-row">
          <label for="dm-y">y_dev</label>
          <output data-o="y">120</output>
        </div>
        <input id="dm-y" type="range" min="40" max="220" step="5" value="120" data-p="y" />
      </div>
      <div class="field">
        <div class="field-row">
          <label for="dm-r">rot_dev</label>
          <output data-o="r">10°</output>
        </div>
        <input id="dm-r" type="range" min="-20" max="20" step="1" value="10" data-p="r" />
      </div>
      <div class="menu-actions">
        <button type="button" class="btn" data-menu-add>Add button</button>
        <button type="button" class="btn" data-menu-remove>Remove</button>
        <button type="button" class="btn" data-menu-reset>Scene values</button>
      </div>
      <pre class="menu-code" data-menu-code></pre>
    </div>
  </div>

  <div class="toy-note">
    <p>
      Each child is placed from the bottom of the list upward: shifted by <code>index × x_dev</code>, raised by{' '}
      <code>index × y_dev</code> and turned by <code>index × rot_dev</code> around its bottom-right corner. Add or remove a
      button and the container re-sorts itself, as it does in the editor.
    </p>
  </div>
</div>

<style>
  .menu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
  }

  .menu-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0c0b0b center / cover no-repeat;
    border-right: 1px solid var(--rule);
  }

  /* A 1920x1080 scene, scaled to fit with --s set from script. */
  .menu-scene {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
    transform-origin: 0 0;
    transform: scale(var(--s, 0.3));
  }

  .menu-btn {
    position: absolute;
    left: 0;
    top: 0;
    width: 800px;
    height: 160px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-origin: 100% 100%;
    transition: transform 0.45s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  .menu-btn img {
    width: 100%;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.3, 1.8, 0.4, 1);
    animation: float 2.2s ease-in-out infinite alternate;
  }

  .menu-btn:nth-child(2n) img {
    animation-duration: 1.8s;
    animation-delay: -0.4s;
  }

  .menu-btn:nth-child(3n) img {
    animation-duration: 2.6s;
    animation-delay: -0.9s;
  }

  /* title_button.gd: scale to 1.1 on hover with an elastic tween. */
  .menu-btn:hover img,
  .menu-btn:focus-visible img {
    transform: scale(1.1);
  }

  .menu-btn:focus-visible {
    outline: 6px solid #fff;
  }

  @keyframes float {
    to {
      translate: 0 -10px;
    }
  }

  .menu-side {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 0.9rem;
    min-width: 0;
  }

  .menu-side label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .menu-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .menu-actions .btn {
    min-height: 2.5rem;
    padding-inline: 0.7rem;
    font-size: 0.72rem;
  }

  .menu-code {
    margin: 0;
    padding: 0.6rem 0.7rem;
    overflow-x: auto;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .menu-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .menu-stage {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
  }
</style>

<script>
  const DEFAULTS = { x: -60, y: 120, r: 10 };
  const SIZE = { w: 800, h: 160 };
  // Where the container sits in the 1920x1080 title scene (bottom-right of the stack).
  const ORIGIN = { x: 1700, y: 820 };

  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-menu-stage]')!;
    const scene = root.querySelector<HTMLElement>('[data-menu-scene]')!;
    const code = root.querySelector<HTMLElement>('[data-menu-code]')!;
    const params = { ...DEFAULTS };
    const templates = [...scene.querySelectorAll<HTMLElement>('[data-menu-btn]')];

    /** The body of _notification(NOTIFICATION_SORT_CHILDREN). */
    function sortChildren(): void {
      const children = [...scene.querySelectorAll<HTMLElement>('[data-menu-btn]')];
      const count = children.length;
      const lines: string[] = [];
      children.forEach((c, i) => {
        const index = count - 1 - i;
        const x = -index * params.x - SIZE.w;
        const y = -index * params.y;
        const rot = index * params.r;
        c.style.transform = `translate(${ORIGIN.x + x}px, ${ORIGIN.y + y}px) rotate(${rot}deg)`;
        lines.push(`child ${i}: pos (${x}, ${y})  rot ${rot}°`);
      });
      code.textContent = lines.join('\n');
      root.querySelector('[data-o="x"]')!.textContent = String(params.x).replace('-', '−');
      root.querySelector('[data-o="y"]')!.textContent = String(params.y);
      root.querySelector('[data-o="r"]')!.textContent = `${String(params.r).replace('-', '−')}°`;
    }

    root.querySelectorAll<HTMLInputElement>('[data-p]').forEach((slider) => {
      slider.addEventListener('input', () => {
        params[slider.dataset.p as keyof typeof params] = Number(slider.value);
        sortChildren();
      });
    });

    root.querySelector('[data-menu-add]')?.addEventListener('click', () => {
      const count = scene.querySelectorAll('[data-menu-btn]').length;
      if (count >= 6) return;
      scene.append(templates[count % templates.length]!.cloneNode(true));
      sortChildren();
    });
    root.querySelector('[data-menu-remove]')?.addEventListener('click', () => {
      const children = scene.querySelectorAll('[data-menu-btn]');
      if (children.length > 1) children[children.length - 1]!.remove();
      sortChildren();
    });
    root.querySelector('[data-menu-reset]')?.addEventListener('click', () => {
      Object.assign(params, DEFAULTS);
      root.querySelectorAll<HTMLInputElement>('[data-p]').forEach((slider) => {
        slider.value = String(DEFAULTS[slider.dataset.p as keyof typeof DEFAULTS]);
      });
      sortChildren();
    });

    new ResizeObserver(() => scene.style.setProperty('--s', String(stage.clientWidth / 1920))).observe(stage);
    sortChildren();
  });
</script>
