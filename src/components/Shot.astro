---
// One captioned screenshot on a project page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  pixel?: boolean;
  sizes?: string;
}

const { src, alt, caption, pixel = false, sizes = '(max-width: 900px) 100vw, 40vw' } = Astro.props;
---

<figure class="shot">
  <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes={sizes} class:list={[{ pixel }]} />
  {caption && <figcaption class="label">{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  figcaption {
    margin-top: 0.55rem;
    max-width: 48ch;
    text-wrap: pretty;
  }
</style>
