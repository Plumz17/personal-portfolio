---
import { url } from '../lib/site';
import { profile } from '../data/profile';
---

<footer class="site-footer">
  <div class="wrap inner">
    <p class="label">
      {profile.shortName}, {profile.location}
    </p>
    <ul>
      {
        profile.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
      <li><a href={url('/archive')}>Archive</a></li>
    </ul>
    <p class="colophon">
      Built with Astro. The art, sound and music all come from the games themselves. The music is from Truths Astray.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 8rem);
    border-top: 1px solid var(--rule);
    padding-block: 2rem 6rem;
  }
  .inner {
    display: grid;
    gap: 0.8rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.94rem;
  }
  ul a {
    display: inline-block;
    padding-block: 0.4rem;
  }
  p {
    margin: 0;
  }
  .colophon {
    font-size: 0.85rem;
    color: var(--ink-2);
  }
</style>
