---
// A walkable hallway from Truths Astray. The characters, foreground props,
// and wall map are the game's own sprites. The room is
// redrawn on canvas in the game's palette, because in the game it is a 3D
// voxel scene with no flat background to reuse. Doors are real links, so the
// strip is optional: everything it reaches is also in the page below.
import { media, url } from '../lib/site';

const cast = (name: string) => media(`truths-astray/cast/${name}.png`);
const prop = (name: string) => media(`truths-astray/props/${name}.png`);

const doors = [
  { x: 320, label: 'Selected work', href: '#work' },
  { x: 840, label: 'More projects', href: '#more' },
  { x: 1360, label: 'Leadership', href: '#leadership' },
  { x: 1880, label: 'Everything', href: url('/archive') },
  { x: 2400, label: 'About & contact', href: '#about' },
];

// Everyone in the hallway can be talked to. Dorothy is the site guide; the
// others each have one conversation in src/content/dialogue/<Name>.md.
// fps is each character's idle speed from the game (entities/npc/resources/*.tres).
const cast_ = [
  { name: 'Dorothy', x: 590, fps: 8 },
  { name: 'Sarah', x: 1100, fps: 5 },
  { name: 'Wei', x: 1540, fps: 6 },
  { name: 'Krishna', x: 2140, fps: 4 },
  { name: 'Jenny', x: 2610, fps: 4 },
];

const config = {
  width: 2720,
  doors: doors.map((door) => door.x),
  // Speeds from the game's astara.tscn: idle at 5 fps, the "run" animation at 7.
  astara: {
    idle: { src: cast('astara_idle'), frames: 6, fps: 5, w: 180, h: 180 },
    walk: { src: cast('astara_walk'), frames: 8, fps: 7, w: 180, h: 180 },
  },
  // Idle sheets are 6 frames of 180x200; each character keeps their own speed.
  npcs: cast_.map((npc) => ({ ...npc, src: cast(`${npc.name.toLowerCase()}_idle`) })),
  map: { src: prop('map'), x: 1650, w: 140, h: 98 },
  fans: { src: prop('kipas'), xs: [1100, 2140] },
  // Silhouettes drawn in front of everything and scrolled faster, as the game does.
  foreground: [
    { src: prop('boxes_left'), x: 20 },
    { src: prop('plant'), x: 1120 },
    { src: prop('lamp'), x: 2020 },
    { src: prop('table'), x: 2950 },
    { src: prop('boxes_right'), x: 3560 },
  ],
};
---

<section class="strip" data-strip data-config={JSON.stringify(config)} aria-label="Walk through the Truths Astray hallway">
  <div
    class="stage"
    data-stage
    tabindex="0"
    role="group"
    aria-label="Walkable scene. Arrow keys walk, E opens the nearest door or talks to the nearest person."
    data-keys
  >
    <canvas class="pixel" data-canvas></canvas>
    <div class="signs">
      {
        doors.map((door) => (
          <a class="sign" href={door.href} data-sign data-x={door.x}>
            <span>{door.label}</span>
            <kbd class="key" aria-hidden="true">E</kbd>
          </a>
        ))
      }
      {
        cast_.map((npc) => (
          <button type="button" class="sign talk" data-sign data-talk={npc.name} data-x={npc.x}>
            <span>Talk to {npc.name}</span>
            <kbd class="key" aria-hidden="true">E</kbd>
          </button>
        ))
      }
    </div>
    <div class="pad">
      <button type="button" data-walk="-1" aria-label="Walk left">
        <svg viewBox="0 0 5 9" aria-hidden="true"><path d="M4 0h1v9h-1v-1h-1v-1h-1v-1h-1v-1h-1v-1h1v-1h1v-1h1v-1h1z" /></svg>
      </button>
      <button type="button" data-walk="1" aria-label="Walk right">
        <svg viewBox="0 0 5 9" aria-hidden="true"><path d="M0 0h1v1h1v1h1v1h1v1h1v1h-1v1h-1v1h-1v1h-1v1h-1z" /></svg>
      </button>
    </div>
  </div>
  <p class="caption wrap">
    <span class="label">Astara and the newsroom, from Truths Astray</span>
    <span>Arrow keys, the buttons, or tap where you want them to go. The doors are links, and everyone in the hall will talk.</span>
  </p>
</section>

<style>
  .strip {
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  /* --scale is one scene pixel in CSS pixels. --ppx is the pixel the walk
     buttons are built from: the same, except on phones, where the scene runs
     at 1x and the buttons use 2x so they stay a comfortable size. */
  .stage {
    --scale: 2;
    --ppx: 2;
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--rule);
    background: #030404;
    cursor: pointer;
    touch-action: pan-y;
  }

  .stage:focus-visible {
    outline-offset: -4px;
  }

  /* Sized in whole scene pixels by the script; never stretched to fit. */
  canvas {
    display: block;
    max-width: none;
  }

  .signs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* A door plate: its bottom edge sits just above the door frame at any scale.
     The script centres it over its door on whole pixels. */
  .sign {
    position: absolute;
    left: 0;
    top: calc(var(--scale) * 52px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem;
    translate: 0 -100%;
    border: 2px solid #1d1a14;
    background: #f0e6c0;
    color: #1d1a14;
    box-shadow: 3px 3px 0 #05080c;
    font-family: var(--font-pixel);
    font-size: 0.95rem;
    line-height: 1.3;
    white-space: nowrap;
    text-decoration: none;
    pointer-events: auto;
    cursor: pointer;
    will-change: transform;
  }

  /* Dorothy's prompt hangs over her head rather than over a door. */
  .sign.talk {
    top: calc(var(--scale) * 66px);
  }

  /* Speech prompts bob three scene pixels, in hard steps like a sprite. */
  @media (prefers-reduced-motion: no-preference) {
    .sign.talk {
      animation: talk-bob 1.6s steps(1, end) infinite;
    }
  }

  @keyframes talk-bob {
    0%,
    100% {
      translate: 0 -100%;
    }
    25%,
    75% {
      translate: 0 calc(-100% - var(--scale) * 2px);
    }
    50% {
      translate: 0 calc(-100% - var(--scale) * 3px);
    }
  }

  .sign .key {
    display: none;
  }

  .sign[data-near] {
    background: #1d1a14;
    color: #f0e6c0;
    border-color: #f0e6c0;
  }

  .sign[data-near] .key {
    display: inline-grid;
  }

  .sign:hover {
    background: #fff8dc;
    color: #1d1a14;
    border-color: #1d1a14;
  }

  .pad {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.5rem;
    display: flex;
    justify-content: flex-start;
    gap: 0.5rem;
    padding-inline: 0.5rem;
    pointer-events: none;
  }

  .pad button {
    display: grid;
    place-items: center;
    width: calc(var(--ppx) * 24px);
    height: calc(var(--ppx) * 24px);
    padding: 0;
    border: calc(var(--ppx) * 1px) solid #1d1a14;
    background: #f0e6c0;
    color: #1d1a14;
    box-shadow: calc(var(--ppx) * 2px) calc(var(--ppx) * 2px) 0 #05080c;
    cursor: pointer;
    pointer-events: auto;
    touch-action: none;
    user-select: none;
  }

  .pad svg {
    width: calc(var(--ppx) * 5px);
    height: calc(var(--ppx) * 9px);
    fill: currentColor;
    shape-rendering: crispEdges;
  }

  .pad button:active {
    translate: calc(var(--ppx) * 1px) calc(var(--ppx) * 1px);
    box-shadow: calc(var(--ppx) * 1px) calc(var(--ppx) * 1px) 0 #05080c;
  }

  @media (max-width: 40rem) {
    .sign {
      font-size: 0.85rem;
      padding: 0.15rem 0.45rem;
    }
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
    margin-top: 0.6rem;
    max-width: none;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

</style>

<script>
  import { reducedMotion, theme } from '../lib/state';
  import { footstep } from '../lib/sound';

  interface Sheet {
    src: string;
    frames: number;
    fps: number;
    w: number;
    h: number;
  }
  interface Npc {
    name: string;
    x: number;
    fps: number;
    src: string;
  }
  interface Config {
    width: number;
    doors: number[];
    astara: { idle: Sheet; walk: Sheet };
    npcs: Npc[];
    map: { src: string; x: number; w: number; h: number };
    fans: { src: string; xs: number[] };
    foreground: { src: string; x: number }[];
  }

  // Logical pixels. Sprites are drawn at native size; the canvas is scaled up whole.
  const VIEW_H = 280;
  const CEILING = 30;
  const BAND_Y = 168; // where the wall changes from dark to slate
  const FLOOR_Y = 240;
  const DOOR_W = 84;
  const DOOR_TOP = 62;
  const NPC_FEET = 258;
  const FEET_Y = 271;
  const NPC = { w: 180, h: 200, frames: 6 };
  const SPEED = 120;
  const NEAR = 64;
  const FOREGROUND_SPEED = 1.3;
  const STEP_EVERY = 0.5; // seconds, the game's footstep timer

  // Where each character's feet are in their frame, measured from the sheets:
  // the offset of the feet from the frame's centre, and how wide they stand.
  const FEET: Record<string, { off: number; w: number }> = {
    astara: { off: 0, w: 30 },
    dorothy: { off: -5, w: 68 },
    sarah: { off: 1, w: 40 },
    wei: { off: 1, w: 40 },
    krishna: { off: 1, w: 27 },
    jenny: { off: -9, w: 47 },
  };
  // A contact shadow, row by row from the top: how far in from each end the
  // row starts. Solid in the middle, dithered at the rim.
  const SHADOW_ROWS = [6, 2, 0, 0, 1, 3, 7];

  // Sampled from the game's office and bedroom. Every colour is solid: soft
  // light is made by checker dithering between two of them, never by alpha,
  // so the scene stays a fixed palette of hard pixels.
  const DAY = {
    ceiling: '#030404',
    ceilingEdge: '#0b1117',
    trim: '#17212c',
    wall: '#0f1a26',
    wallHi: '#16232f',
    wallLo: '#0a121b',
    glow: '#1b2836',
    band: '#2f404e',
    bandHi: '#3a4d5c',
    bandLo: '#26343f',
    rail: '#22303c',
    skirting: '#22303c',
    skirtingHi: '#2f404e',
    floor: '#374b5d',
    floorLo: '#2e3f4f',
    floorHi: '#41576a',
    spill: '#5b6a70',
    frame: '#767a80',
    frameHi: '#9a9ea4',
    frameLo: '#4f545b',
    jamb: '#373e48',
    jambHi: '#454d58',
    room: '#554432',
    roomDeep: '#3f3225',
    roomFloor: '#8a7a5c',
    roomFloorLo: '#76684e',
    light: '#f4f4f4',
    lightLo: '#c9ced3',
    lightFrame: '#343434',
    ceilingLamp: '#f4f4f4',
    lampGlow: '#1e2328',
    shadow: '#1d2934',
    lit: true,
  };
  const DUSK: typeof DAY = {
    ...DAY,
    wall: '#0a121b',
    wallHi: '#0f1923',
    wallLo: '#060c12',
    band: '#1c2833',
    bandHi: '#24323e',
    bandLo: '#16202a',
    rail: '#131c25',
    skirting: '#131c25',
    skirtingHi: '#1c2833',
    floor: '#212e3a',
    floorLo: '#1b2630',
    floorHi: '#283745',
    spill: '#6f6a58',
    frame: '#4a4f57',
    frameHi: '#5e636b',
    frameLo: '#33373d',
    jamb: '#232830',
    jambHi: '#2c323b',
    room: '#8f7c58',
    roomDeep: '#7a6a4b',
    roomFloor: '#beb495',
    roomFloorLo: '#a89e80',
    light: '#1a232d',
    lightLo: '#151c24',
    lightFrame: '#10161d',
    ceilingLamp: '#2a323b',
    shadow: '#0c131a',
    lit: false,
  };

  const load = (src: string): HTMLImageElement => Object.assign(new Image(), { src });

  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((root) => {
    const config = JSON.parse(root.dataset.config ?? '{}') as Config;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const signs = [...root.querySelectorAll<HTMLElement>('[data-sign]')].map((el) => ({
      el,
      x: Number(el.dataset.x),
      wIdle: 0,
      wNear: 0,
    }));

    const idle = load(config.astara.idle.src);
    const walk = load(config.astara.walk.src);
    const npcs = config.npcs.map((npc) => ({ ...npc, img: load(npc.src) }));
    const map = load(config.map.src);
    const fan = load(config.fans.src);
    const foreground = config.foreground.map((item) => ({ ...item, img: load(item.src) }));
    const worldW = config.width;

    let scale = 2;
    let ppx = 2;
    let viewW = 720;
    let x = 150;
    let facing = 1;
    let held = 0; // -1, 0, 1 from keys or buttons
    let target: number | null = null; // tap-to-walk destination
    let clock = 0;
    let last = 0;
    let visible = true;
    let near: (typeof signs)[number] | null = null;
    let stepIn = 0; // seconds until the next footstep

    function resize(): void {
      const width = stage.clientWidth;
      scale = width < 760 ? 1 : width < 2100 ? 2 : 3;
      viewW = Math.ceil(width / scale);
      canvas.width = viewW;
      canvas.height = VIEW_H;
      // Whole multiples only: the stage clips the last part-pixel column.
      canvas.style.width = `${viewW * scale}px`;
      canvas.style.height = `${VIEW_H * scale}px`;
      ppx = Math.max(scale, 2);
      stage.style.setProperty('--scale', String(scale));
      stage.style.setProperty('--ppx', String(ppx));
      // Plates are a whole number of pixels wide, so both edges stay sharp.
      // The nearest plate grows to show its key, so measure both.
      const snap = (px: number) => Math.ceil(px / ppx) * ppx;
      signs.forEach((sign) => {
        const wasNear = sign.el.hasAttribute('data-near');
        sign.el.style.width = '';
        sign.el.setAttribute('data-near', '');
        sign.wNear = snap(sign.el.getBoundingClientRect().width);
        sign.el.removeAttribute('data-near');
        sign.wIdle = snap(sign.el.getBoundingClientRect().width);
        sign.el.toggleAttribute('data-near', wasNear);
      });
      ctx.imageSmoothingEnabled = false;
      draw();
    }

    // Follows Astara and stops at both ends, like the game's hallway camera.
    function camera(): number {
      return Math.max(0, Math.min(worldW - viewW, x - viewW / 2));
    }

    // A 2x2 checker for dithering. Its phase follows the camera so the
    // pattern is fixed to the world and does not crawl while walking.
    const checker = document.createElement('canvas');
    checker.width = 2;
    checker.height = 2;
    const checkerCtx = checker.getContext('2d')!;
    const patterns = new Map<string, CanvasPattern>();
    function dither(colour: string, cam: number): CanvasPattern {
      let pattern = patterns.get(colour);
      if (!pattern) {
        checkerCtx.clearRect(0, 0, 2, 2);
        checkerCtx.fillStyle = colour;
        checkerCtx.fillRect(0, 0, 1, 1);
        checkerCtx.fillRect(1, 1, 1, 1);
        pattern = ctx.createPattern(checker, 'repeat')!;
        patterns.set(colour, pattern);
      }
      pattern.setTransform(new DOMMatrix().translate(-(cam % 2), 0));
      return pattern;
    }

    function rect(colour: string | CanvasPattern, x: number, y: number, w: number, h: number): void {
      ctx.fillStyle = colour;
      ctx.fillRect(x, y, w, h);
    }

    /** A raised frame: light on the top and left edges, shade on the others. */
    function bevel(x: number, y: number, w: number, h: number, base: string, hi: string, lo: string): void {
      rect(base, x, y, w, h);
      rect(hi, x, y, w, 1);
      rect(hi, x, y, 1, h);
      rect(lo, x, y + h - 1, w, 1);
      rect(lo, x + w - 1, y, 1, h);
    }

    function drawRoom(cam: number, c: typeof DAY): void {
      // Ceiling, wall, wainscot and floor.
      rect(c.ceiling, 0, 0, viewW, CEILING);
      rect(c.ceilingEdge, 0, CEILING - 1, viewW, 1);
      rect(c.wall, 0, CEILING, viewW, BAND_Y - CEILING);
      rect(c.trim, 0, CEILING, viewW, 4);
      rect(c.wallHi, 0, CEILING + 4, viewW, 1);
      rect(c.band, 0, BAND_Y, viewW, FLOOR_Y - BAND_Y);
      rect(c.floor, 0, FLOOR_Y, viewW, VIEW_H - FLOOR_Y);

      // Wall panels every 64 px and wainscot boards every 16, in world space.
      for (let wx = Math.floor(cam / 16) * 16; wx < cam + viewW; wx += 16) {
        const px = wx - cam;
        if (wx % 64 === 0) {
          rect(c.wallLo, px, CEILING + 5, 1, BAND_Y - CEILING - 5);
          rect(c.wallHi, px + 1, CEILING + 5, 1, BAND_Y - CEILING - 5);
        }
        rect(c.bandLo, px, BAND_Y + 3, 1, FLOOR_Y - BAND_Y - 7);
        rect(c.bandHi, px + 1, BAND_Y + 3, 1, FLOOR_Y - BAND_Y - 7);
      }

      // Chair rail and skirting, each with a lit top edge.
      rect(c.rail, 0, BAND_Y, viewW, 3);
      rect(c.bandHi, 0, BAND_Y, viewW, 1);
      rect(c.skirting, 0, FLOOR_Y - 4, viewW, 4);
      rect(c.skirtingHi, 0, FLOOR_Y - 4, viewW, 1);

      // Floor tiles in perspective: rows widen towards the viewer, and the
      // seams fan out from the middle of the view, one pixel row at a time.
      rect(c.floorHi, 0, FLOOR_Y, viewW, 1);
      for (const row of [4, 10, 18, 29]) rect(c.floorLo, 0, FLOOR_Y + row, viewW, 1);
      const centre = viewW / 2;
      for (let wx = Math.floor((cam - 120) / 48) * 48; wx < cam + viewW + 120; wx += 48) {
        const base = wx - cam;
        for (let r = 1; r < VIEW_H - FLOOR_Y; r += 1) {
          rect(c.floorLo, Math.round(base + ((base - centre) * r) / 90), FLOOR_Y + r, 1, 1);
        }
      }

      // Three light panels on the wall between each pair of doors, as in the office.
      const bays = [0, ...config.doors, worldW];
      for (let i = 0; i < bays.length - 1; i += 1) {
        const from = bays[i]! + (i === 0 ? 20 : DOOR_W / 2 + 34);
        const to = bays[i + 1]! - (i === bays.length - 2 ? 20 : DOOR_W / 2 + 34);
        const gap = 12;
        const w = Math.floor((to - from - gap * 2) / 3);
        if (w < 40) continue;
        for (let n = 0; n < 3; n += 1) {
          const px = Math.round(from + n * (w + gap) - cam);
          if (px > viewW || px + w < 0) continue;
          if (c.lit) rect(dither(c.glow, cam), px - 4, 40, w + 8, 36);
          rect(c.lightFrame, px, 44, w, 28);
          rect(c.light, px + 3, 47, w - 6, 22);
          rect(dither(c.lightLo, cam), px + 3, 65, w - 6, 2);
          rect(c.lightLo, px + 3, 67, w - 6, 2);
        }
        // One recessed ceiling lamp per bay, like the one above each room in the game.
        const lamp = Math.round((from + to) / 2 - cam);
        if (c.lit) rect(dither(c.lampGlow, cam), lamp - 14, 12, 28, 8);
        rect(c.ceilingLamp, lamp - 10, 15, 20, 2);
        rect(c.ceilingLamp, lamp - 7, 14, 14, 4);
      }

      // Doorways: a bevelled frame, a jamb for depth, a warm room behind,
      // a shadow under the lintel, and dithered light on the floor.
      for (const door of config.doors) {
        const left = Math.round(door - DOOR_W / 2 - cam);
        if (left > viewW + 40 || left + DOOR_W < -40) continue;
        bevel(left - 7, DOOR_TOP - 7, DOOR_W + 14, FLOOR_Y - DOOR_TOP + 7, c.frame, c.frameHi, c.frameLo);
        rect(c.frameLo, left - 1, DOOR_TOP - 1, DOOR_W + 2, 1);
        rect(c.room, left, DOOR_TOP, DOOR_W, FLOOR_Y - DOOR_TOP);
        rect(c.roomDeep, left, DOOR_TOP, DOOR_W, 8);
        rect(dither(c.roomDeep, cam), left, DOOR_TOP + 8, DOOR_W, 4);
        rect(c.roomFloor, left, FLOOR_Y - 22, DOOR_W, 22);
        rect(c.roomFloorLo, left, FLOOR_Y - 22, DOOR_W, 1);
        rect(dither(c.roomFloorLo, cam), left, FLOOR_Y - 21, DOOR_W, 2);
        rect(c.jamb, left, DOOR_TOP, 9, FLOOR_Y - DOOR_TOP);
        rect(c.jambHi, left + 8, DOOR_TOP, 1, FLOOR_Y - DOOR_TOP);
        // The light fans out one pixel row at a time: solid by the door,
        // dithered as it thins out.
        for (let row = 0; row < VIEW_H - FLOOR_Y; row += 1) {
          const fill = row < 6 ? c.spill : dither(c.spill, cam);
          rect(fill, left + 9 - row, FLOOR_Y + row, DOOR_W - 9 + row * 2, 1);
        }
      }

      // The Navaport district map, in a bevelled frame.
      if (map.complete && map.naturalWidth) {
        const mx = Math.round(config.map.x - cam);
        if (mx < viewW && mx + config.map.w > 0) {
          bevel(mx - 4, 95, config.map.w + 8, config.map.h + 8, c.ceiling, c.wallHi, c.ceiling);
          ctx.drawImage(map, mx, 99);
        }
      }

      if (fan.complete && fan.naturalWidth) {
        for (const fx of config.fans.xs) {
          const dx = Math.round(fx - fan.naturalWidth / 2 - cam);
          if (dx < viewW && dx + fan.naturalWidth > 0) ctx.drawImage(fan, dx, CEILING - 6);
        }
      }
    }

    function drawSprite(
      img: HTMLImageElement,
      frame: number,
      w: number,
      h: number,
      centre: number,
      feet: number,
      flip: boolean,
    ): void {
      if (!img.complete || !img.naturalWidth) return;
      const dx = Math.round(centre - w / 2);
      const dy = feet - h;
      if (dx > viewW || dx + w < 0) return;
      if (flip) {
        ctx.save();
        ctx.translate(dx + w, dy);
        ctx.scale(-1, 1);
        ctx.drawImage(img, frame * w, 0, w, h, 0, 0, w, h);
        ctx.restore();
      } else {
        ctx.drawImage(img, frame * w, 0, w, h, dx, dy, w, h);
      }
    }

    /** A flat pixel ellipse on the floor, centred under a character's feet. */
    function shadow(c: typeof DAY, cam: number, centre: number, feet: number, w: number): void {
      // Wider than the stance, and mostly below the soles so it shows.
      w += 14;
      const left = Math.round(centre - w / 2);
      const top = feet - 3;
      SHADOW_ROWS.forEach((inset, row) => {
        const rimW = Math.max(0, w - inset * 2);
        if (rimW <= 0) return;
        // The rim is dithered; the inner part solid.
        rect(dither(c.shadow, cam), left + inset - 3, top + row, rimW + 6, 1);
        rect(c.shadow, left + inset, top + row, rimW, 1);
      });
    }

    function draw(): void {
      const cam = Math.round(camera());
      const dusk = theme() === 'dusk';
      const still = reducedMotion();
      const palette = dusk ? DUSK : DAY;
      drawRoom(cam, palette);

      // Shadows belong to the floor, so the dusk dimming falls on them too.
      for (const npc of npcs) {
        const feet = FEET[npc.name.toLowerCase()] ?? { off: 0, w: 40 };
        const flip = x < npc.x;
        shadow(palette, cam, npc.x - cam + (flip ? -feet.off : feet.off), NPC_FEET, feet.w);
      }
      shadow(palette, cam, x - cam, FEET_Y, FEET.astara!.w);

      if (dusk) {
        // Lights off: dim the room and let the doorways glow. This is part of
        // the background, so the characters are drawn in front of the light.
        ctx.fillStyle = 'rgba(4, 8, 16, 0.42)';
        ctx.fillRect(0, 0, viewW, VIEW_H);
        ctx.fillStyle = 'rgba(190, 180, 149, 0.5)';
        for (const door of config.doors) {
          const left = Math.round(door - DOOR_W / 2 - cam);
          if (left < viewW && left + DOOR_W > 0) ctx.fillRect(left + 9, DOOR_TOP, DOOR_W - 9, FLOOR_Y - DOOR_TOP);
        }
        ctx.filter = 'brightness(0.72)';
      }

      // The cast stand by the wall and turn to face Astara.
      for (const npc of npcs) {
        const frame = still ? 0 : Math.floor(clock * npc.fps) % NPC.frames;
        drawSprite(npc.img, frame, NPC.w, NPC.h, npc.x - cam, NPC_FEET, x < npc.x);
      }

      const moving = held !== 0 || target !== null;
      const sheet = moving ? config.astara.walk : config.astara.idle;
      const frame = still && !moving ? 0 : Math.floor(clock * sheet.fps) % sheet.frames;
      drawSprite(moving ? walk : idle, frame, sheet.w, sheet.h, x - cam, FEET_Y, facing < 0);
      ctx.filter = 'none';

      const front = Math.round(cam * FOREGROUND_SPEED);
      for (const item of foreground) {
        if (!item.img.complete || !item.img.naturalWidth) continue;
        const dx = item.x - front;
        if (dx < viewW && dx + item.img.naturalWidth > 0) {
          ctx.drawImage(item.img, dx, VIEW_H - item.img.naturalHeight + 8);
        }
      }

      near = null;
      let best = NEAR;
      for (const sign of signs) {
        const distance = Math.abs(sign.x - x);
        if (distance < best) {
          best = distance;
          near = sign;
        }
      }
      for (const sign of signs) {
        const isNear = sign === near;
        const w = isNear ? sign.wNear : sign.wIdle;
        const sx = (sign.x - cam) * scale;
        // Centred, then snapped to the plate's own pixel grid.
        const left = Math.round((sx - w / 2) / ppx) * ppx;
        sign.el.toggleAttribute('data-near', isNear);
        if (w) sign.el.style.width = `${w}px`;
        sign.el.style.transform = `translateX(${left}px)`;
        sign.el.style.visibility = sx > -140 && sx < viewW * scale + 140 ? 'visible' : 'hidden';
      }
    }

    function step(now: number): void {
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      if (visible) {
        clock += dt;
        let dir = held;
        if (dir === 0 && target !== null) {
          if (Math.abs(target - x) < 2) target = null;
          else dir = Math.sign(target - x);
        }
        if (dir !== 0) {
          facing = dir;
          const before = x;
          x = Math.max(40, Math.min(worldW - 40, x + dir * SPEED * dt));
          stepIn -= dt;
          if (x !== before && stepIn <= 0) {
            footstep();
            stepIn = STEP_EVERY;
          }
        } else {
          stepIn = 0;
        }
        draw();
      }
      requestAnimationFrame(step);
    }

    function activate(): void {
      near?.el.click();
    }

    // Dorothy's prompt opens the site guide as usual; anyone else starts
    // their own conversation in the same dialogue box.
    root.querySelectorAll<HTMLElement>('[data-talk]').forEach((el) =>
      el.addEventListener('click', () => {
        held = 0;
        target = null;
        const name = el.dataset.talk ?? '';
        document.dispatchEvent(
          name === 'Dorothy' ? new CustomEvent('pf:guide') : new CustomEvent('pf:talk', { detail: name }),
        );
      }),
    );

    // Keyboard, only while the stage has focus so the page still scrolls normally.
    stage.addEventListener('keydown', (event) => {
      const key = event.key.toLowerCase();
      if (key === 'arrowleft' || key === 'a') held = -1;
      else if (key === 'arrowright' || key === 'd') held = 1;
      else if (key === 'e' || (key === 'enter' && event.target === stage)) activate();
      else return;
      target = null;
      event.preventDefault();
    });
    stage.addEventListener('keyup', (event) => {
      const key = event.key.toLowerCase();
      if (['arrowleft', 'a', 'arrowright', 'd'].includes(key)) held = 0;
    });
    stage.addEventListener('blur', () => (held = 0));

    // Hold-to-walk buttons.
    root.querySelectorAll<HTMLButtonElement>('[data-walk]').forEach((btn) => {
      const dir = Number(btn.dataset.walk);
      const stop = () => (held = 0);
      btn.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        btn.setPointerCapture(event.pointerId);
        target = null;
        held = dir;
      });
      btn.addEventListener('pointerup', stop);
      btn.addEventListener('pointercancel', stop);
      btn.addEventListener('keydown', (event) => {
        if (event.key === ' ' || event.key === 'Enter') {
          event.preventDefault();
          held = dir;
        }
      });
      btn.addEventListener('keyup', stop);
      btn.addEventListener('blur', stop);
    });

    // Tap or click the scene to walk there.
    canvas.addEventListener('click', (event) => {
      const rect = canvas.getBoundingClientRect();
      target = camera() + (event.clientX - rect.left) / scale;
      stage.focus({ preventScroll: true });
    });

    new IntersectionObserver(([entry]) => (visible = entry?.isIntersecting ?? true)).observe(stage);
    new ResizeObserver(resize).observe(stage);
    // Plate widths depend on the pixel font; measure again once it has loaded.
    void document.fonts.ready.then(resize);
    document.addEventListener('pf:theme', draw);
    [idle, walk, map, fan, ...npcs.map((n) => n.img), ...foreground.map((f) => f.img)].forEach((img) =>
      img.addEventListener('load', draw),
    );
    resize();
    requestAnimationFrame(step);
  });
</script>
